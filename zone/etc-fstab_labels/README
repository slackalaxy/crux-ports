## I prefer XFS, so that's in the example fstab.

## To see existing labels:
#  lsblk -o name,mountpoint,label,size

## An EFI partition on /dev/sda1:
#  mkfs.vfat -F 32 /dev/sda1
#  fatlabel /dev/sda1 EFI

## An EXT4 partition on /dev/sda2:
#  mkfs.ext4 /dev/sda2
#  e2label /dev/sda2 BOOT

## A XFS partition on /dev/sda3:
#  mkfs.xfs /dev/sda3
#  xfs_admin -L ROOT /dev/sda3

## A SWAP partition on /dev/sda4:
#  mkswap /dev/sda4
#  swaplabel -L SWAP /dev/sda4
