#!/bin/bash

## Use colour by default
alias ls="ls --color=auto"
alias ll="ls -al"
alias cd..='cd ..'
alias ..='cd ..'

## I am not smart enough for vim
export VISUAL=nano
export EDITOR=nano

# Colours for ls. If the ls_colors port is installed, use its big
# extension:colour mapping. Otherwise fall back to the database built
# into dircolors (coreutils), which covers the common file types.
if [ -f /etc/profile.d/lscolors.sh ]; then
  source /etc/profile.d/lscolors.sh
else
  eval "$(dircolors -b)"
fi

if [ -f /etc/profile.d/vte.sh ]; then
  source /etc/profile.d/vte.sh
fi

# when a shell saves its history, it adds to ~/.bash_history instead of
# overwriting it, so no terminal wipes out another's commands.
shopt -s histappend

# A command typed in one terminal is immediately available when
# pressing UP in every other terminal.
# PROMPT_COMMAND="history -a; history -c; history -r; $PROMPT_COMMAND"

# Each terminal's UP shows its own commands, everything still gets saved
# right away, and new terminals start with the full history.
PROMPT_COMMAND="history -a; $PROMPT_COMMAND"

# Prompt colour, where '$' is green. Replace XX with one of these:
#   30  black    90  dark grey
#   31  red      91  bright red
#   32  green    92  bright green
#   33  yellow   93  bright yellow
#   34  blue     94  bright blue
#   35  magenta  95  bright magenta
#   36  cyan     96  bright cyan
#   37  grey     97  white
PS1='\[\e[1;32m\]\$\[\e[0m\] '

# Over SSH: the computer name in yellow, then "$" in cyan.
if [ -n "$SSH_CONNECTION" ]; then
	PS1='\[\e[1;33m\]\h\[\e[1;36m\]\$\[\e[0m\] '
fi
