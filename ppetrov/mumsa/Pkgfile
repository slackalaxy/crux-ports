# Description: Assessment of the quality of multiple sequence alignments
# URL: http://msa.sbc.su.se/cgi-bin/msa.cgi
# Maintainer: Petar Petrov, slackalaxy at gmail dot com

name=mumsa
version=1.0
release=1
source=(https://raw.githubusercontent.com/slackalaxy/sources/main/$name-$version.tgz)

build() {
	cd $name-$version
	sed -i "/^CFLAGS/s/=/+=/" Makefile
	PREFIX=/usr make
	install -D -m755 $name $PKG/usr/bin/$name
}
