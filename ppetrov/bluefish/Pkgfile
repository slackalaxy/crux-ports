# Description: A powerful editor
# URL: https://bluefish.openoffice.nl/index.html
# Maintainer: Petar Petrov, slackalaxy at gmail dot com
# Depends on: gtk3

name=bluefish
version=2.4.2
release=1
source=(https://sourceforge.net/projects/bluefish/files/bluefish/$version/$name-$version.tar.bz2)

build() {
	cd $name-$version
	
	./configure --prefix=/usr \
		--disable-nls \
		--disable-update-databases \
		--disable-xml-catalog-update \
		--disable-spell-check
	
	make
	make DESTDIR=$PKG install
	
	rm -rf $PKG/usr/share/{doc,xml}
}
