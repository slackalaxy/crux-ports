# Description: Clustal Omega
# URL: https://bio.tools/clustalo
# Maintainer: Petar Petrov, slackalaxy at gmail dot com
# Depends on: argtable

name=clustalo
version=1.2.4
release=2
source=(https://raw.githubusercontent.com/slackalaxy/sources/main/clustal-omega-$version.tar.gz)

build() {
	cd clustal-omega-$version

	./configure --prefix=/usr

	make
	make install DESTDIR=$PKG
	
	rm -rf $PKG/usr/share
	rm -f $PKG/usr/lib/*.la
}
