# Description: lshw: HardWare LiSter for Linux
# URL: https://github.com/lyonel/lshw/tags
# Maintainer: Petar Petrov, slackalaxy at gmail dot com
# Depends on: gtk3 polkit xorg-libxcomposite xorg-libxcursor xorg-libxinerama

name=lshw
version=B.02.20
release=1
source=(https://github.com/lyonel/lshw/archive/$version/$name-$version.tar.gz
	$name.desktop $name.png $name-pkexec.sh)

build() {
	cd $name-$version
  	
	RPM_OPT_FLAGS="$CXXFLAGS" \
	make 
	make gui
	make DESTDIR=$PKG install
	make DESTDIR=$PKG install-gui
	
	# polkit wrapper
	install $SRC/$name-pkexec.sh -D -m 755 $PKG/usr/bin/$name-pkexec
	
	mkdir -p $PKG/usr/share/{applications,pixmaps}
	cp -a $SRC/$name.desktop $PKG/usr/share/applications
	cp -a $SRC/$name.png $PKG/usr/share/pixmaps
	
	rm -rf $PKG/usr/share/locale
}
