# Description:	PAR Packager
# URL:		http://search.cpan.org/~rschupp/PAR-Packer/
# Maintainer:	Petar Petrov, slackalaxy at gmail dot com
# Depends on:	p5-getopt-argvfile p5-module-scandeps p5-par
# Optional:	p5-module-signature p5-tk p5-tk-coloredbutton p5-tk-entrycheck p5-tk-getopt

name=p5-par-packer
version=1.064
release=1
source=(http://search.cpan.org/CPAN/authors/id/R/RS/RSCHUPP/PAR-Packer-${version}.tar.gz)

build() {
	cd PAR-Packer-$version

	# PERL_MM_USE_DEFAULT=1 \
	perl Makefile.PL
	make OPTIMIZE="$CFLAGS" DESTDIR="$PKG" install

	find "$PKG" -depth \
		-type f \( -name .packlist -o -name \*.bs -o -name perllocal.pod \) -delete , \
		-type f -name autosplit.ix \( -exec grep -q '^[[:space:]]*package' {} \; -o -delete \) , \
		-type d -empty -exec rmdir {} +
}
