# Depends on: brotli graphite2 gtkmm3 libxkbcommon xorg-libxcomposite xorg-libxcursor xorg-libxinerama xorg-libxres

name=gbgoffice
version=6e68645
release=1
source=(https://github.com/slackalaxy/gbgoffice3/archive/$version/gbgoffice3-6e686456f9095392021717cacff68fbb73f855ca.tar.gz)

build() {
	cd gbgoffice3-${version}*
	
	./configure --prefix=/usr
	make
	make install DESTDIR=$PKG
}
