# Description: CLI/GTK3 thesaurus
# URL: https://github.com/slackalaxy/gaiksaurus3
# Maintainer: Petar Petrov, slackalaxy at gmail dot com
# Depends on: brotli graphite2 gtk3 libxkbcommon xorg-libxcomposite xorg-libxcursor xorg-libxinerama xorg-libxres

name=aiksaurus
version=fe88099
release=1
source=(https://github.com/slackalaxy/gaiksaurus3/archive/$version/gaiksaurus3-fe880996189553487f5d12a685d702b4c787f914.tar.gz)

build() {
	cd gaiksaurus3-${version}*
	./configure --prefix=/usr
	make
	make DESTDIR="$PKG" install
	
	rm -f $PKG/{,usr/}lib/*.la
	
	# start in systray by default
	sed -i 's:Exec=gaiksaurus:Exec=gaiksaurus -t:' $PKG/usr/share/applications/gaiksaurus.desktop
}
