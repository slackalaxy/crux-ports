# Description: The lightweight GTK+ clipboard manager.
# URL: https://github.com/rickyrockrat/parcellite/tags
# Maintainer: Petar Petrov, slackalaxy at gmail dot com
# Depends on: brotli graphite2 gtk xorg-libxdamage

name=parcellite
version=1.2.5
release=2
source=(https://github.com/rickyrockrat/parcellite/archive/refs/tags/$version.tar.gz
	port-to-gtk-3.patch)
renames=($name-$version.tar.gz SKIP)

build() {
	cd $name-$version
	
	patch -Np1 -i $SRC/port-to-gtk-3.patch
	
	sed -i "/^CFLAGS/s/=/+=/" src/Makefile
	make
	make install DESTDIR=$PKG
	
	rm -rf $PKG/usr/share/locale
}
