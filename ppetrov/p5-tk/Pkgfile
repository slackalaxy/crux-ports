# Description: Perl Tk module
# URL: http://search.cpan.org/~srezic/Tk/
# Maintainer: Petar Petrov, slackalaxy at gmail dot com
# Depends on: perl tk

name=p5-tk
version=804.036
release=1
source=(http://search.cpan.org/CPAN/authors/id/S/SR/SREZIC/Tk-${version}.tar.gz
	gcc-14.patch)

build() {
	cd Tk-$version
	patch -p1 -i $SRC/gcc-14.patch # Fix build with GCC 14
	
	# PERL_MM_USE_DEFAULT=1 \
	perl Makefile.PL
	make OPTIMIZE="$CFLAGS -Wno-incompatible-pointer-types -Wno-implicit-int -std=gnu17" DESTDIR="$PKG" install

	find "$PKG" -depth \
		-type f \( -name .packlist -o -name \*.bs -o -name perllocal.pod \) -delete , \
		-type f -name autosplit.ix \( -exec grep -q '^[[:space:]]*package' {} \; -o -delete \) , \
		-type d -empty -exec rmdir {} +
	
	find $PKG/ -name "*README*" -delete
}
