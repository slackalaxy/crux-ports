# Description: A virtual sticky pad system
# URL: https://launchpad.net/xpad
# Maintainer: Petar Petrov, slackalaxy at gmail dot com
# Depends on: brotli graphite2 gtksourceview4 libayatana-appindicator libxkbcommon wayland xorg-libxres

name=xpad
version=5.8.0
release=2
source=(https://launchpad.net/xpad/trunk/$version/+download/xpad-${version}.tar.bz2
	01_allow_build_with_newer_gettext.diff
	$name.svg $name.desktop)

build() {
	cd $name-$version
	
	# Thanks Debian and Alpine
	patch -p1 -i $SRC/01_allow_build_with_newer_gettext.diff
	autoreconf -vfi -I /usr/share/gettext/m4

	./configure --prefix=/usr \
		--disable-nls

	make
	make DESTDIR="$PKG" install
	
	sed -i 's:StartupNotify=true:StartupNotify=false:g' $PKG/usr/share/applications/$name.desktop
	
	#mkdir -p $PKG/usr/etc/xdg/autostart
	#cp $SRC/$name.desktop $PKG/usr/etc/xdg/autostart
	
	# Use this icon...
	rm -rf $PKG/usr/share/icons/hicolor/scalable/apps/xpad.svg
	cp $SRC/xpad.svg $PKG/usr/share/icons/hicolor/scalable/apps/
}
