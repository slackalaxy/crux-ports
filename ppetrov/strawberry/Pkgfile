# Description: Strawberry music player
# URL: https://www.strawberrymusicplayer.org/
# Maintainer: Petar Petrov, slackalaxy at gmail dot com
# Depends on: fftw gst-plugins-bad gst-plugins-good gst-plugins-ugly kdsingleapplication librsvg pulseaudio
# Optional: krb5 x264 x265

name=strawberry
version=1.2.29
release=1
source=(https://files.strawberrymusicplayer.org/$name-$version.tar.xz)

build() {

  # https://github.com/strawberrymusicplayer/strawberry/issues/2310
  sed -i '140i #ifdef HAVE_TAGFETCHER' $name-$version/src/settings/settingsdialog.cpp
  sed -i '142i #endif' $name-$version/src/settings/settingsdialog.cpp
  
  cmake -S $name-$version -B build            \
        -DCMAKE_BUILD_TYPE=Release            \
        -DCMAKE_INSTALL_PREFIX=/usr           \
        -DCMAKE_INSTALL_LIBDIR=lib            \
        -DCMAKE_C_FLAGS_RELEASE="$CFLAGS"     \
        -DCMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
        -DENABLE_CHROMAPRINT=OFF              \
        -DENABLE_SONGTRACKING=OFF             \
        -DENABLE_TAGFETCHER=OFF               \
	-DENABLE_AUDIOCD=OFF                  \
	-DENABLE_MTP=OFF                      \
	-DENABLE_GPOD=OFF                     \
	-DENABLE_EBUR128=OFF                  \
	-DENABLE_STREAMTAGREADER=OFF          \
	-DENABLE_DISCORD_RPC=OFF              \
	-DENABLE_SONGFINGERPRINTING=OFF       \
	-DENABLE_TRANSLATIONS=OFF             \
	-DENABLE_MUSICBRAINZ=OFF              \
	-DENABLE_MOODBAR=ON                   \
        -Wno-dev

  cmake --build build
  DESTDIR="$PKG" cmake --install build

  mkdir -p $PKG/usr/share/pixmaps/
  cp -a $PKG/usr/share/icons/hicolor/48x48/apps/$name.png \
  $PKG/usr/share/pixmaps/$name.png

}
