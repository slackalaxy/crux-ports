# Description: A probabilistic multiple alignment program
# URL: https://github.com/ariloytynoja/prank-msa/tree/master/binaries
# Maintainer: Petar Petrov, slackalaxy at gmail dot com
# Depends on: mafft exonerate bppsuite

name=prank
version=251117
release=2
source=(https://raw.githubusercontent.com/ariloytynoja/prank-msa/master/binaries/prank.source.$version.tgz
	$name-io.sh)

build() {
	cd $name-msa/src

	CPPFLAGS="$CXXFLAGS" make
	
	install -D -m 755 $name $PKG/usr/bin/$name
	install -D -m 755 $SRC/$name-io.sh $PKG/usr/bin/$name-io
	install -D -m 644 $name.1 $PKG/usr/share/man/man1/$name.1
}
