# Description: Dia is an editor for diagrams, graphs, charts etc. 
# URL: https://packages.debian.org/sid/dia
# Maintainer: Petar Petrov, slackalaxy at gmail dot com
# Depends on: brotli graphene graphite2 gtk3 libdeflate libwebp libxkbcommon libxslt nss openjpeg2 poppler wayland xorg-libxcomposite xorg-libxcursor xorg-libxinerama xorg-libxres

name=dia
version=0.98+git20260221
_debian=3
release=1
source=(https://ftp.debian.org/debian/pool/main/d/dia/dia_${version}.orig.tar.gz
	https://ftp.debian.org/debian/pool/main/d/dia/dia_${version}-${_debian}.debian.tar.xz)

build() {
	# Thanks to Debian for the source and patches
	cat $SRC/debian/patches/series | while read -r i ; do
		patch -p1 -i $SRC/debian/patches/$i
	done
	
	meson setup . build            \
		--buildtype=plain      \
		--prefix=/usr          \
		--wrap-mode nodownload \
		-Db_pie=true           \
		-Db_lto=true           \
		-Ddoc=disabled         \
		-Dtests=false

	meson compile -C build -j ${JOBS:-1}
	DESTDIR="$PKG" meson install -C build
	
	rm -r $PKG/usr/share/locale
}
