+  set_res_value("msa_name_3", "muscle5");
+  set_res_value("msa_args_3", "-align %f.pir -output %f.out");
+  /* MAFFT writes to standard output; Seaview handles the ">" itself */
+  set_res_value("msa_name_4", "mafft");
+  set_res_value("msa_args_4", "--auto %f.pir > %f.out");
+  set_res_value("msa_name_5", "mafft-linsi");
+  set_res_value("msa_args_5", "%f.pir > %f.out");
+  set_res_value("msa_name_6", "mafft-einsi");
+  set_res_value("msa_args_6", "%f.pir > %f.out");
+  set_res_value("msa_name_7", "mafft-ginsi");
+  set_res_value("msa_args_7", "%f.pir > %f.out");
