#!/bin/sh
# The plugin runs openvpn as an unprivileged user called "nm-openvpn"
# and locks it into /var/lib/openvpn/chroot. On systemd systems these
# are created automatically from sysusers.d/tmpfiles.d; CRUX has no
# systemd, so we create them here. Commands skip if already done.

getent group nm-openvpn >/dev/null || groupadd -r nm-openvpn

getent passwd nm-openvpn >/dev/null || useradd -r -g nm-openvpn -d /var/lib/openvpn/chroot -s /bin/false nm-openvpn

install -d -o nm-openvpn -g nm-openvpn -m 755 /var/lib/openvpn/chroot
