# Description: A powerful text editor for MATE
# URL: http://www.mate-desktop.org/
# Maintainer: Matt Housh, jaeger at crux dot ninja
# Depends on: enchant gtksourceview4 libpeas iso-codes

name=pluma
version=1.28.1
release=1
source=(https://github.com/mate-desktop/$name/releases/download/v${version}/$name-$version.tar.xz)

build() {
  cd $name-$version

 sed -i -e '/PKG_CONFIG/s,enchant ,enchant-2 ,g' configure
  ./configure --prefix=/usr \
    --libexecdir=/usr/lib/$name \
    --enable-python \
    --disable-nls
  make
  make DESTDIR=$PKG install

  rm -r $PKG/usr/share/gtk-doc
}
