# Description: A set set of plugins for Pluma, the MATE text editor. 
# URL: https://github.com/mate-desktop/pluma-plugins/
# Maintainer: Petar Petrov, slackalaxy at gmail dot com
# Depends on: brotli graphite2 libxkbcommon pluma wayland xorg-libxres

name=pluma-plugins
version=1.28.0
release=1
source=(https://github.com/mate-desktop/pluma-plugins/releases/download/v$version/pluma-plugins-$version.tar.xz)

build() {
  cd $name-$version
  # autoreconf -fvi
  ./configure --prefix=/usr \
  	--disable-nls

  make
  make DESTDIR="$PKG" install
  rm -r $PKG/usr/share/help
}
