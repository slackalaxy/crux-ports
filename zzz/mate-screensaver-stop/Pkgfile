# Description: Stop MATE screensaver when a window is in fullscreen
# URL: https://github.com/slackalaxy/xscreensaver-stopper
# Maintainer: Petar Petrov, slackalaxy at gmail dot com
# Depends on: mate-screensaver

name=mate-screensaver-stop
version=1.28
release=1
source=($name.sh $name.desktop)

build() {
  install -D -m 0755 $SRC/$name.sh $PKG/usr/bin/$name.sh
  install -D -m 0644 $SRC/$name.desktop $PKG/etc/xdg/autostart/$name.desktop
}
