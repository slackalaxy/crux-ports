name=r4-prroc
version=1.4
release=1
source=(https://cloud.r-project.org/src/contrib/PRROC_${version}.tar.gz)

build() {
	cd PRROC
	mkdir -p $PKG/usr/lib/R/library
	R CMD INSTALL . -l $PKG/usr/lib/R/library
}
