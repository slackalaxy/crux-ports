name=r4-rcppparallel
version=6.2.0
release=1
source=(https://cloud.r-project.org/src/contrib/RcppParallel_${version}.tar.gz)

build() {
	cd RcppParallel
	mkdir -p $PKG/usr/lib/R/library
	R CMD INSTALL . -l $PKG/usr/lib/R/library
}
