name=r4-vegan
version=2.7.6
release=1
source=(https://cloud.r-project.org/src/contrib/vegan_2.7-6.tar.gz)

build() {
	cd vegan
	mkdir -p $PKG/usr/lib/R/library
	R CMD INSTALL . -l $PKG/usr/lib/R/library
}
