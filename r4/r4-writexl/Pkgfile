name=r4-writexl
version=2.0.0
release=1
source=(https://cloud.r-project.org/src/contrib/writexl_${version}.tar.gz)

build() {
	cd writexl
	mkdir -p $PKG/usr/lib/R/library
	R CMD INSTALL . -l $PKG/usr/lib/R/library
}
