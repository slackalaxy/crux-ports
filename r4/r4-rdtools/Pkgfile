# Description: R-package rdtools
# URL: https://cran.r-project.org/web/packages/rdtools
# Maintainer: Petar Petrov, slackalaxy at gmail dot com
# Depends on: r 
# Optional: r4-testthat r4-withr

name=r4-rdtools
version=0.1.0
release=1
source=(https://cloud.r-project.org/src/contrib/rdtools_${version}.tar.gz)

build() {
	cd rdtools
	mkdir -p $PKG/usr/lib/R/library
	R CMD INSTALL . -l $PKG/usr/lib/R/library
}
