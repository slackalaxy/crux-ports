name=r4-countrycode
version=1.9.0
release=1
source=(https://cloud.r-project.org/src/contrib/countrycode_${version}.tar.gz)

build() {
	cd countrycode
	mkdir -p $PKG/usr/lib/R/library
	R CMD INSTALL . -l $PKG/usr/lib/R/library
}
