# Description: R-package ggplotify
# URL: https://cran.r-project.org/web/packages/ggplotify
# Maintainer: Petar Petrov, slackalaxy at gmail dot com
# Depends on: r r4-ggplot2 r4-gridgraphics r4-rlang r4-yulab-utils
# Optional: r4-aplot r4-colorspace r4-ggimage r4-knitr r4-lattice r4-patchwork r4-quarto r4-testthat r4-vcd

name=r4-ggplotify
version=0.1.4
release=1
source=(https://cloud.r-project.org/src/contrib/ggplotify_${version}.tar.gz)

build() {
	cd ggplotify
	mkdir -p $PKG/usr/lib/R/library
	R CMD INSTALL . -l $PKG/usr/lib/R/library
}
