# Description: R-package safetensors
# URL: https://cran.r-project.org/web/packages/safetensors
# Maintainer: Petar Petrov, slackalaxy at gmail dot com
# Depends on: r r4-cli r4-jsonlite r4-r6 r4-rlang
# Optional: r4-testthat r4-torch

name=r4-safetensors
version=0.2.1
release=1
source=(https://cloud.r-project.org/src/contrib/safetensors_${version}.tar.gz)

build() {
	cd safetensors
	mkdir -p $PKG/usr/lib/R/library
	R CMD INSTALL . -l $PKG/usr/lib/R/library
}
