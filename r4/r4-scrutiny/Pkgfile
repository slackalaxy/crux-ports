# Description: R-package scrutiny
# URL: https://cran.r-project.org/web/packages/scrutiny
# Maintainer: Petar Petrov, slackalaxy at gmail dot com
# Depends on: r r4-cli r4-corrr r4-dplyr r4-ggplot2 r4-ggrepel r4-glue r4-lifecycle r4-magrittr r4-purrr r4-rlang r4-stringr r4-tibble r4-tidyr r4-tidyselect
# Optional: r4-knitr r4-pkgload r4-rmarkdown r4-testthat

name=r4-scrutiny
version=0.6.1
release=1
source=(https://cloud.r-project.org/src/contrib/scrutiny_${version}.tar.gz)

build() {
	cd scrutiny
	mkdir -p $PKG/usr/lib/R/library
	R CMD INSTALL . -l $PKG/usr/lib/R/library
}
