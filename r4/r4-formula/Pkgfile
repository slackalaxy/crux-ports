# Description: R-package Formula
# URL: https://cran.r-project.org/web/packages/Formula
# Maintainer: Petar Petrov, slackalaxy at gmail dot com
# Depends on: r 
# Optional: r4-knitr r4-rmarkdown

name=r4-formula
version=1.2.6
release=1
source=(https://cloud.r-project.org/src/contrib/Formula_1.2-6.tar.gz)

build() {
	cd Formula
	mkdir -p $PKG/usr/lib/R/library
	R CMD INSTALL . -l $PKG/usr/lib/R/library
}
