# Depends on: r r4-data-table r4-dplyr r4-matrix r4-purrr r4-rcpp r4-rcpparmadillo r4-rlang r4-tibble r4-tidyr
# Optional: r4-biocstyle r4-broom r4-delayedarray r4-deseq2 r4-knitr r4-rmarkdown r4-seurat r4-singlecellexperiment r4-summarizedexperiment r4-testthat

name=r4-presto
version=1.1.0
release=1
source=(https://cloud.r-project.org/src/contrib/presto_${version}.tar.gz)

build() {
	cd presto
	mkdir -p $PKG/usr/lib/R/library
	R CMD INSTALL . -l $PKG/usr/lib/R/library
}
