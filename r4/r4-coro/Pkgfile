# Description: R-package coro
# URL: https://cran.r-project.org/web/packages/coro
# Maintainer: Petar Petrov, slackalaxy at gmail dot com
# Depends on: r r4-rlang
# Optional: r4-knitr r4-later r4-magrittr r4-promises r4-reticulate r4-rmarkdown r4-testthat

name=r4-coro
version=1.1.0
release=1
source=(https://cloud.r-project.org/src/contrib/coro_${version}.tar.gz)

build() {
	cd coro
	mkdir -p $PKG/usr/lib/R/library
	R CMD INSTALL . -l $PKG/usr/lib/R/library
}
