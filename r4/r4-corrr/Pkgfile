# Depends on: r r4-dplyr r4-ggplot2 r4-ggrepel r4-glue r4-purrr r4-rlang r4-seriation r4-tibble
# Optional: r4-covr r4-dbi r4-dbplyr r4-knitr r4-rmarkdown r4-rsqlite r4-sparklyr r4-testthat

name=r4-corrr
version=0.4.5
release=1
source=(https://cloud.r-project.org/src/contrib/corrr_${version}.tar.gz)

build() {
	cd corrr
	mkdir -p $PKG/usr/lib/R/library
	R CMD INSTALL . -l $PKG/usr/lib/R/library
}
